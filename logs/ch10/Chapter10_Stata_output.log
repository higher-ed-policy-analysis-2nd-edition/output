>         kernel(triangular) bwselect(mserd)
  3.     di as text "    `c'     " %7.4f e(tau_cl) "   " %6.4f e(pv_rb) "     below"
  4. }
    -0.60      0.2400   0.0085     below
    -0.40     -0.0893   0.2719     below
    -0.20     -0.0979   0.3524     below

. foreach c in 0.20 0.40 0.60 {
