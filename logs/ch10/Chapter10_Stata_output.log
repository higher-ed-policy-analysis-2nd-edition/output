.     qui replace hi = `b_nc' + 1.96*`se_nc'         in 2

. 
.     * Row 3 – State-specific linear trends
.     qui replace b  = `b_tr'                        in 3

.     qui replace lo = `b_tr' - 1.96*`se_tr'         in 3

.     qui replace hi = `b_tr' + 1.96*`se_tr'         in 3

. 
