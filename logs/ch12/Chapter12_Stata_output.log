. * ── Sensitivity of the point-estimate CBA (REVISIONS 4 and 6) ───────────────
. * Two assumptions drive the size of the net benefit:
. *   (1) Displacement function. Baseline: normal(overage/50), which gives a
. *       student $1 over the limit a 0.50 probability of leaving. Alternative:
. *       2*normal(overage/50) - 1, which starts at 0 and rises toward 1.
. *   (2) Earnings horizon. Baseline: 30 years. Alternative: 10 years.
. * The PRTE depends only on the displacement function (it changes the weights).
. di _n "--- Sensitivity of the point-estimate CBA ($000s) ---"

--- Sensitivity of the point-estimate CBA ($000s) ---

. di "Displacement    Horizon  Displaced    PRTE  Forgone earn.  Net social ben.    BCR  Federal acct."
Displacement    Horizon  Displaced    PRTE  Forgone earn.  Net social ben.    BCR  Federal acct.

. foreach alt in 0 1 {
  2.     foreach yrs in 30 10 {
  3.         if `alt' == 0 {
  4.             qui gen double sens_pd = normal(loan_overage/50) * above_cap
  5.             local dlab "normal(o/50)"
  6.         }
  7.         else {
  8.             qui gen double sens_pd = (2*normal(loan_overage/50) - 1) * above_cap
  9.             local dlab "2normal(o/50)-1"
 10.         }
 11.         qui gen double sens_de = sens_pd * masters
 12.         qui sum sens_de if masters == 1
 13.         local nd_k = r(sum)
 14.         qui gen double sens_w = sens_de * tt_hat / `nd_k' if masters == 1
 15.         qui sum sens_w
 16.         local prte_k = r(sum)
 17.         local pv_k = (1 - (1 + $discount_rate)^(-`yrs')) / $discount_rate
 18.         qui replace sens_w = sens_de * max(0, tt_hat) * ($base_salary/1000) * `pv_k' if masters == 1
 19.         qui sum sens_w
 20.         local bc_k = r(sum)
 21.         qui replace sens_w = sens_de * max(0, -tt_hat) * ($base_salary/1000) * `pv_k' if masters == 
> 1
 22.         qui sum sens_w
 23.         local eg_k = r(sum)
 24.         qui replace sens_w = sens_de * (gross_tuition - net_inst_rev) if masters == 1
 25.         qui sum sens_w
 26.         local ai_k = r(sum)
 27.         qui replace sens_w = $subsidy_rate * (sens_de * grad_plus_loans ///
>             + (above_cap - sens_de) * loan_overage)
 28.         qui sum sens_w
 29.         local fs_k = r(sum)
 30.         local nb_k  = -`bc_k' + `eg_k' + `ai_k'
 31.         local fed_k = `fs_k' - $tax_rate * (`bc_k' - `eg_k')
 32.         di %-15s "`dlab'" %9.0f `yrs' %11.1f `nd_k' %8.4f `prte_k' %15.1fc `bc_k' ///
>            %17.1fc `nb_k' %7.3f (`ai_k' + `eg_k')/max(1, `bc_k') %15.1fc `fed_k'
 33.         drop sens_pd sens_de sens_w
 34.     }
 35. }
