. local h2 = 0.50

. 
. gen byte   in_bw2  = (abs(x) <= `h2')

. gen double tri_wt2 = (1 - abs(x) / `h2') * in_bw2

. gen double x_Ds2   = x * D_sharp

. 
. foreach outcome in persist_fuzzy credits_y1 cgpa_y1 {
  2.     ivregress 2sls `outcome' (D_fuzzy = D_sharp) x x_Ds2 ///
>         [aw = tri_wt2] if in_bw2, robust
  3.     local iv_`outcome'_b  = _b[D_fuzzy]
  4.     local iv_`outcome'_se = _se[D_fuzzy]
  5.     local iv_`outcome'_p  = 2 * normal(-abs(`iv_`outcome'_b' / `iv_`outcome'_se'))
