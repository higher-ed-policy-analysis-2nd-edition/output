. 
. foreach cf of local control_fips {
  2.     qui xtreg lngenop did $controls i.fy if fips != `cf', ///
>         fe vce(cluster fips)
  3.     post `loo_h' (`cf') (_b[did]) ///
>         (_b[did] - 1.96*_se[did]) ///
>         (_b[did] + 1.96*_se[did])
  4.     di "." _continue
  5. }
...............
