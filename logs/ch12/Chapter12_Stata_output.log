>         (`net_benefit_s') (`nb_per_student_s') (`bcr_s') (`pnb_positive_s') ///
>         (`inst_rev_loss_s') (`cross_sub_loss_s') (`nb_extended_s')
 42. 
.     * Progress indicator every 100 draws
.     if mod(`s', 100) == 0 {
 43.         di as text "  Draw `s' / $S_draws complete"
 44.     }
 45. }
  Draw 100 / 1000 complete
  Draw 200 / 1000 complete
  Draw 300 / 1000 complete
  Draw 400 / 1000 complete
  Draw 500 / 1000 complete
  Draw 600 / 1000 complete
  Draw 700 / 1000 complete
