. ********************************************************************************
. * SECTION 11: PRTE BY POLICY INTENSITY (uniform GA increase)
. ********************************************************************************
. 
. di _n "=============================================="

==============================================

. di "PRTE BY POLICY INTENSITY"
PRTE BY POLICY INTENSITY

. di "=============================================="
==============================================

. 
. matrix INT = J(20, 2, .)

. forvalues i = 1/20 {
  2.     local inc = `i' * 0.5
  3.     capture drop _p_int
  4.     gen double _p_int = normal(z_index + `ga_coef'*`inc')
  5.     quietly mtefe ln_salary $X_controls (masters = ga_funding_adj), ///
>         pol(2) bootreps(0) noplot prte(_p_int)
  6.     matrix INT[`i',1] = `inc'
  7.     matrix INT[`i',2] = _b[effects:prte]
  8.     drop _p_int
  9. }

. 
