. * Standard errors and MTE confidence band from the bootstrap draws
. matrix MLO = J(1, 99, .)

. matrix MHI = J(1, 99, .)

. preserve

.     use "`bootfile'", clear

.     qui count

.     local n_boot = r(N)

.     foreach s in ate att atu late mprte1 {
  2.         qui sum b_`s'
  3.         local `s'_se = r(sd)
  4.     }

.     if `run_areas' == 1 {
.         foreach a in stem business education health other {
  2.             foreach s in ate att atu late {
  3.                 qui sum b_`s'_`a'
  4.                 local `s'_se_`a' = r(sd)
