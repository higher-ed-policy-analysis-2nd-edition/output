  7.             local nb_`a' = r(N)
  8.         }
.     }

.     forvalues j = 1/99 {
  2.         _pctile m`j', p(2.5 97.5)
  3.         matrix MLO[1,`j'] = r(r1)
  4.         matrix MHI[1,`j'] = r(r2)
  5.     }

. restore

