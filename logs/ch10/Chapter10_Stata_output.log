. *-----------------------------------------------------
. * 1.  FALLBACK PATHS (standalone execution)
. *-----------------------------------------------------
. * Resolve $out_root once, then DERIVE every output directory from it.
. *
. * Stata globals persist across do-files within a session, so a value set by
. * an earlier run survives into this one.  Two earlier rules both leaked:
. *   "set it if it is empty"       -- a stale RELATIVE value survived and sent
. *                                    output to the working directory (the bug
. *                                    that misplaced tab10_7_etwfe.rtf on
. *                                    14 Aug 2026).
. *   "accept it if it is ABSOLUTE" -- a stale ABSOLUTE value survived too.  On
. *                                    19 Aug 2026 a standalone RDD.do run
. *                                    inherited $log_dir = .../Output/log,
. *                                    left by an earlier run whose fallback
. *                                    used the singular name; it was absolute,
. *                                    so the guard accepted it and the log was
. *                                    written to the wrong directory.
. *
. * Derivation removes the failure mode: nothing inherited can survive, so the
. * paths cannot drift from $out_root.  This costs nothing when the master
. * calls the script, because Stata_code10.do derives the same directories from
. * the same $out_root -- the values are identical.  To redirect output, change
. * $out_root, not the individual directories.
. global out_root "Output"

. if c(username) == "marvi" {
.     global out_root "C:/Users/marvi/Dropbox/Book/2nd Edition/Chapter 10/Output"
. }

. capture mkdir "$out_root"

. 
. local cur "$graphs_dir"

. global graphs_dir "$out_root/graphs"

. if "`cur'" != "" & "`cur'" != "$graphs_dir" {
.     di as text "Georgia_DiD.do: replacing inherited graphs_dir (`cur')"
. }

. di as text "Georgia_DiD.do: graphs_dir = $graphs_dir"
Georgia_DiD.do: graphs_dir = C:/Users/marvi/Dropbox/Book/2nd Edition/Chapter 10/Output/graphs

. capture mkdir "$graphs_dir"

. 
. * $tables_dir was never set by this script, only echoed and then used by the
. * three -export delimited- calls in Section 10.9.  A standalone run therefore
. * wrote results.csv, results_lasso.csv and results_combined.csv to "/results.csv"
. * relative to the working directory.  Derived here alongside the others.
. local cur "$tables_dir"

. global tables_dir "$out_root/tables"

. if "`cur'" != "" & "`cur'" != "$tables_dir" {
.     di as text "Georgia_DiD.do: replacing inherited tables_dir (`cur')"
. }

. di as text "Georgia_DiD.do: tables_dir = $tables_dir"
Georgia_DiD.do: tables_dir = C:/Users/marvi/Dropbox/Book/2nd Edition/Chapter 10/Output/tables

. capture mkdir "$tables_dir"

