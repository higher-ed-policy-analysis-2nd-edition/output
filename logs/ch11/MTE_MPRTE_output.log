Area      N     Completers   ATE       ATT       ATU       LATE
.     di "-------------------------------------------------------------------"
-------------------------------------------------------------------
.     foreach a in stem business education health other {
  2.         qui count if grp_`a' == 1
  3.         local n_`a' = r(N)
  4.         qui count if grp_`a' == 1 & masters == 1
  5.         local ntr_`a' = r(N)
  6. 
.         capture noisily mtefe ln_salary $X_controls (masters = ga_funding_adj) ///
>             if grp_`a' == 1, pol(1) bootreps(0) noplot savepropensity(p_area_`a')
  7.         if _rc == 0 {
  8.             est store mtefe_`a'
  9.             local ate_`a'  = _b[effects:ate]
 10.             local att_`a'  = _b[effects:att]
 11.             local atu_`a'  = _b[effects:atut]
 12.             local late_`a' = _b[effects:late]
 13.             matrix EB_`a'  = e(b)
 14.             matrix MTE_`a' = EB_`a'[1, "mte:"]
 15.             matrix SUP_`a' = e(support)
 16.             * Common support of the area's propensity score (treated vs untreated)
.             qui sum p_area_`a' if grp_`a' == 1 & masters == 1
 17.             local lo1 = r(min)
 18.             local hi1 = r(max)
 19.             qui sum p_area_`a' if grp_`a' == 1 & masters == 0
 20.             local lo_`a' = max(`lo1', r(min))
 21.             local hi_`a' = min(`hi1', r(max))
 22.         }
 23.         else {
 24.             di as error "mtefe failed for area `a' (rc = " _rc ")"
 25.             foreach s in ate att atu late {
 26.                 local `s'_`a' = .
 27.             }
 28.             local lo_`a' = .
 29.             local hi_`a' = .
 30.         }
 31.     }


